# =====================================================================
# ContextRag — Python Backend Environment Example
# Copy this file to .env and fill in your actual credentials.
# ⚠️  NEVER commit your real .env file to version control.
# =====================================================================

ACCESS_TOKEN_EXPIRE_MINUTES=30
ADMIN_EMAIL=admin@ragplatform.com
ADMIN_PASSWORD=your_admin_password_here
ALGORITHM=HS256
APP_NAME="Enterprise RAG Platform"
APP_VERSION=8.0.0
CACHE_QUERY_TTL=600
CELERY_BROKER_URL=redis://localhost:6379/4
CELERY_RESULT_BACKEND=redis://localhost:6379/5
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_SIZE=10
DATABASE_URL=postgresql://postgres:your_db_password@localhost:5433/rag_db
DEBUG=false
EMBEDDING_DEVICE=cpu
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
ENVIRONMENT=production

# ── Google Gemini ───────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# ── LLM Provider ───────────────────────────────────────────────────
LLM_PROVIDER=ollama   # options: ollama | groq | gemini | openai
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_TIMEOUT=120
OPENAI_API_KEY=your_openai_api_key_here

# ── Groq ────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

PORT=3000

# ── Qdrant Vector DB ────────────────────────────────────────────────
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=rag_documents
QDRANT_VECTOR_SIZE=384

# ── Rate Limiting ────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# ── Redis ────────────────────────────────────────────────────────────
REDIS_CACHE_DB=1
REDIS_JOB_DB=3
REDIS_SESSION_DB=2
REDIS_URL=redis://127.0.0.1:6379/0
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Reranker ─────────────────────────────────────────────────────────
RERANKER_DEVICE=cpu
RERANKER_MODEL=BAAI/bge-reranker-base

# ── Security ─────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_64_char_hex_secret_key_generated_securely

# ── Neo4j (optional — Graph Knowledge Base) ──────────────────────────
NEO4J_URI=neo4j+s://your_neo4j_instance.databases.neo4j.io
NEO4J_USERNAME=your_neo4j_username
NEO4J_PASSWORD=your_neo4j_password
NEO4J_DATABASE=your_neo4j_database
AURA_INSTANCEID=your_aura_instance_id
AURA_INSTANCENAME=your_aura_instance_name
